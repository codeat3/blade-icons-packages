{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo_sqlite": "*",
        "calebporzio/sushi": "^2.3",
        "codeat3/blade-icons-packages-collection": "dev-main",
        "codeat3/phpcs-styles": "^1.2",
        "guzzlehttp/guzzle": "^7.4",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravolt/avatar": "^6.0",
        "livewire/livewire": "^3.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "deployer/deployer": "^7.1",
        "fakerphp/faker": "^1.19",
        "laravel/sail": "^1.13",
        "mockery/mockery": "^1.5",
        "nunomaduro/collision": "^8.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.1",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "format": "vendor/bin/php-cs-fixer fix"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "codeat3/blade-icons-packages-collection",
                "version": "dev-main",
                "source": {
                    "type": "git",
                    "url": "https://github.com/codeat3/blade-icons-packages-collection.git",
                    "reference": "main"
                },
                "require": {
                    "php": "^8.1.0"
                }
            }
        }
    ]
}
